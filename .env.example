# Web server
HOST=0.0.0.0
PORT=8000

# Camera: use "local" for a webcam or "ip" with CAMERA_IP_URL for a phone/IP camera.
CAMERA_MODE=local
CAMERA_INDEX=0
# CAMERA_IP_URL=http://192.168.1.10:8080/video

# Object detection and focused object search
DETECTION_CONFIDENCE=0.50
OPEN_VOCAB_CONFIDENCE=0.20
OPEN_VOCAB_IMAGE_SIZE=960
HOME_SCAN_CONFIDENCE=0.35
TRACKER_MIN_HITS=2
GOAL_ARRIVAL_DISTANCE_M=0.22

# Local runtime data
WORLD_MEMORY_PATH=lumina_world_memory.json
DEPTH_ENGINE_ENABLED=true

# Optional Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional LLM providers. Keep real keys only in your untracked .env file.
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-R1:fastest
HF_MAX_TIMEOUT_MS=15000
